---
export const prerender = false;

const GEO_API_KEY = import.meta.env.IPGEO_API_KEY;

const url = new URL(Astro.request.url);

const coords = [
  { lat: url.searchParams.get('lat'),  lng: url.searchParams.get('lng')  },
  { lat: url.searchParams.get('lat2'), lng: url.searchParams.get('lng2') },
  { lat: url.searchParams.get('lat3'), lng: url.searchParams.get('lng3') },
].filter(c => c.lat && c.lng);

const cities = await Promise.all(coords.map(async ({ lat, lng }) => {
  const [skyRes, geoRes] = await Promise.all([
    fetch(`https://api.ipgeolocation.io/astronomy?apiKey=${GEO_API_KEY}&lat=${lat}&long=${lng}`),
    fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=en`)
  ]);
  const sky = await skyRes.json();
  const geo = await geoRes.json();

  const toXY = (alt, az) => {
    const x = 10 + ((parseFloat(az) - 60) / 240) * 280;
    const y = 145 - (Math.max(0, parseFloat(alt)) / 90) * 135;
    return { x: Math.max(10, Math.min(290, x)), y: Math.max(10, Math.min(145, y)) };
  };

  const sun  = toXY(sky.sun_altitude,  sky.sun_azimuth);
  const moon = toXY(sky.moon_altitude, sky.moon_azimuth);

  return {
    lat, lng,
    sky,
    cityName: geo.city || geo.locality || `${lat}, ${lng}`,
    sunX: sun.x, sunY: sun.y,
    moonX: moon.x, moonY: moon.y,
    sunOpacity:  parseFloat(sky.sun_altitude)  > 0 ? '1' : '0.25',
    moonOpacity: parseFloat(sky.moon_altitude) > 0 ? '1' : '0.25',
    arcNote:
      (parseFloat(sky.sun_altitude)  > 0 ? `Sun ${parseFloat(sky.sun_altitude).toFixed(1)}° above horizon`  : 'Sun below horizon') +
      '  ·  ' +
      (parseFloat(sky.moon_altitude) > 0 ? `Moon ${parseFloat(sky.moon_altitude).toFixed(1)}° above horizon` : 'Moon below horizon'),
  };
}));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Compare — The Space Above</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=Space+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style/style.css" />
  </head>
  <body>
    <div class="outside-compare">

      <header>
        <h1>Compare The Space Above</h1>
      </header>

      <div class="search-wrap">
        <input id="city-input" type="text" placeholder="Add max. 3 cities..." class="city-input" />
        <button id="city-btn" class="city-btn">Add</button>
        <button id="clear-btn" class="city-btn">✕ Clear all</button>
        <a href="/" class="city-btn">← Back</a>
      </div>

      <div class="compare-grid">
        {cities.map((city) => (
          <div class="compare-col">

            <p class="compare-city">{city.cityName}</p>
            <p class="coords">{city.lat}° N · {city.lng}° E</p>

            <div class="arc-details-wrap">
              <div class="arc-details">
                <div class="arc-summary">
                  <p class="arc-label">Sky Arc</p>
                  <svg viewBox="0 0 300 160" style="width:100%;display:block;overflow:visible">
                    <line x1="10" y1="145" x2="290" y2="145" stroke="rgba(120,160,255,0.50)" stroke-width="1"/>
                    <path d="M 10 145 A 140 140 0 0 1 290 145" fill="none" stroke="rgba(245,199,106,0.50)" stroke-width="1" stroke-dasharray="4 4"/>
                    <text x="6"   y="155" font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)">E</text>
                    <text x="148" y="16"  font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)" text-anchor="middle">Zenith</text>
                    <text x="286" y="155" font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)" text-anchor="end">W</text>
                    <circle cx={city.sunX}  cy={city.sunY}      r="8" fill="rgba(245,199,106,0.8)" opacity={city.sunOpacity}/>
                    <text   x={city.sunX}   y={city.sunY - 12}  font-family="Space Mono" font-size="8" fill="#f5c76a" text-anchor="middle" opacity={city.sunOpacity}>Sun</text>
                    <circle cx={city.moonX} cy={city.moonY}     r="6" fill="rgba(200,216,248,0.7)" opacity={city.moonOpacity}/>
                    <text   x={city.moonX}  y={city.moonY - 10} font-family="Space Mono" font-size="8" fill="#c8d8f8" text-anchor="middle" opacity={city.moonOpacity}>Moon</text>
                  </svg>
                  <p class="arc-note">{city.arcNote}</p>
                </div>
                <div class="arc-back">
                  <p class="arc-label">What is the zenith?</p>
                  <p class="flip-text">The zenith is the point directly above you — 90° altitude. The arc shows the path the sun and moon travel from east to west.</p>
                </div>
              </div>
            </div>

            <div class="card">
              <p class="card-title">Moon Phase</p>
              <p class="card-main">{city.sky.moon_phase.replace("_", " ")}</p>
              <p class="card-sub">{city.sky.moon_illumination_percentage}% illuminated</p>
              <p class="card-sub">Moonrise {city.sky.moonrise} · Moonset {city.sky.moonset}</p>
            </div>

            <div class="card sun">
              <p class="card-title">Sun Altitude</p>
              <p class="card-main">{city.sky.sun_altitude}°</p>
              <p class="card-sub">Sunrise {city.sky.sunrise} · Sunset {city.sky.sunset}</p>
              <p class="card-sub">Solar noon {city.sky.solar_noon}</p>
            </div>

            <div class="stats-row">
              <div class="stat">
                <p class="stat-val">{city.sky.sunrise}</p>
                <p class="stat-label">Sunrise</p>
              </div>
              <div class="stat">
                <p class="stat-val">{city.sky.sunset}</p>
                <p class="stat-label">Sunset</p>
              </div>
              <div class="stat">
                <p class="stat-val">{city.sky.moonrise}</p>
                <p class="stat-label">Moonrise</p>
              </div>
              <div class="stat">
                <p class="stat-val">{city.sky.moonset}</p>
                <p class="stat-label">Moonset</p>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>

    <script>
      document.getElementById('city-btn').addEventListener('click', async () => {
        const city = document.getElementById('city-input').value;
        if (!city) return;

        const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`);
        const data = await res.json();

        if (!data.results || !data.results.length) {
          alert('City not found');
          return;
        } 
        // pop up van maken ^

        const { latitude, longitude } = data.results[0];
        const params = new URLSearchParams(window.location.search);

        if (!params.has('lat')) {
          params.set('lat', latitude);
          params.set('lng', longitude);
        } else if (!params.has('lat2')) {
          params.set('lat2', latitude);
          params.set('lng2', longitude);
        } else if (!params.has('lat3')) {
          params.set('lat3', latitude);
          params.set('lng3', longitude);
        } else {
          alert('Maximum 3 cities');
          return;
        }
        // pop up van maken ^
        window.location.search = params.toString();
      });

      document.getElementById('clear-btn').addEventListener('click', () => {
          window.location.href = window.location.pathname;
      });

      document.querySelectorAll('.arc-details-wrap').forEach(wrap => {
        wrap.addEventListener('click', () => wrap.classList.toggle('flipped'));
      });
    </script>
  </body>
</html>