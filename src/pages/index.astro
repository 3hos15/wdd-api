---
export const prerender = false;

const GEO_API_KEY = import.meta.env.IPGEO_API_KEY;

const url = new URL(Astro.request.url);
const lat = url.searchParams.get('lat');
const lng = url.searchParams.get('lng');
// bron 5 in readme

let sky = null;

if (lat && lng) {
  const res = await fetch(`https://api.ipgeolocation.io/astronomy?apiKey=${GEO_API_KEY}&lat=${lat}&long=${lng}`);

  sky = await res.json();
}

let sunX = 150, sunY = 145, moonX = 150, moonY = 145;
let sunOpacity = '0', moonOpacity = '0';
let arcNote = '';

if (sky) {
  const toXY = (alt, az) => {
    const x = 10 + ((parseFloat(az) - 60) / 240) * 280;
    const y = 145 - (Math.max(0, parseFloat(alt)) / 90) * 135;
    return { x: Math.max(10, Math.min(290, x)), y: Math.max(10, Math.min(145, y)) };
  };

  const sun  = toXY(sky.sun_altitude,  sky.sun_azimuth);
  const moon = toXY(sky.moon_altitude, sky.moon_azimuth);

  sunX  = sun.x;  sunY  = sun.y;
  moonX = moon.x; moonY = moon.y;

  sunOpacity  = parseFloat(sky.sun_altitude)  > 0 ? '1' : '0.25';
  moonOpacity = parseFloat(sky.moon_altitude) > 0 ? '1' : '0.25';

  arcNote =
    (parseFloat(sky.sun_altitude)  > 0 ? `Sun ${parseFloat(sky.sun_altitude).toFixed(1)}° above horizon`  : 'Sun below horizon') +
    '  ·  ' +
    (parseFloat(sky.moon_altitude) > 0 ? `Moon ${parseFloat(sky.moon_altitude).toFixed(1)}° above horizon` : 'Moon below horizon');
}

let cityName = null;

if (lat && lng) {
  const geoRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=en`);
  const geoData = await geoRes.json();
  cityName = geoData.city || geoData.locality || null;
}

const illumination = sky ? Math.abs(parseFloat(sky.moon_illumination_percentage)) / 100 : 0;
const isWaning = sky?.moon_phase?.toLowerCase().includes('waning') || sky?.moon_phase?.toLowerCase().includes('last');
const shadowX = isWaning
  ? 22 - (illumination * 44)
  : (illumination * 44) - 22;

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Space Above</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=Space+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style/style.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <main>
      <div class="outside">
    
        <header>
          <!-- bron 2 in readme -->
          <a href="/" class="logo-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="64" height="64">
              <circle cx="16" cy="16" r="16" fill="#060812"/>
              <circle cx="5"  cy="6"  r="0.7" fill="white" opacity="0.8"/>
              <circle cx="26" cy="4"  r="0.6" fill="white" opacity="0.6"/>
              <circle cx="29" cy="14" r="0.7" fill="white" opacity="0.7"/>
              <circle cx="3"  cy="22" r="0.6" fill="white" opacity="0.5"/>
              <line x1="2" y1="24" x2="30" y2="24" stroke="rgba(120,160,255,0.5)" stroke-width="0.8"/>
              <path d="M 2 24 A 14 14 0 0 1 30 24" fill="none" stroke="rgba(245,199,106,0.5)" stroke-width="0.8" stroke-dasharray="2 2"/>
              <circle cx="22" cy="13" r="5" fill="rgba(245,199,106,0.95)"/>
              <circle cx="10" cy="17" r="4.5" fill="rgba(200,216,248,0.9)"/>
              <circle cx="12" cy="17" r="3.5" fill="#060812"/>
            </svg>
          </a>
          <h1>The Space Above {cityName ?? 'You'}</h1>
          <p class="coords">{lat && `${lat}° N · ${lng}° E`}</p>       
        </header>

        <div class="search-wrap">
          <input id="city-input" type="text" placeholder="Search a city..." class="city-input" />
          <button id="city-btn" class="city-btn-color">Search</button>
          <button id="my-location-btn" class="city-btn">↺ Me</button>
          <a href={lat ? `/compare?lat=${lat}&lng=${lng}` : '/compare'} class="city-btn">Compare cities ➚</a>
        </div>

        <div class="arc-details-wrap">
          <div class="arc-details">
        
            <div class="arc-summary">
              <p class="arc-label">Sky Arc — Sun &amp; Moon Position</p>
              <svg viewBox="0 0 300 160" style="width:100%;max-width:500px;display:block;margin:0 auto;overflow:visible">
                <line x1="10" y1="145" x2="290" y2="145" stroke="rgba(120,160,255,0.50)" stroke-width="1"/>
                <path d="M 10 145 A 140 140 0 0 1 290 145" fill="none" stroke="rgba(245,199,106,0.50)" stroke-width="1" stroke-dasharray="4 4"/>
                <text x="6"   y="155" font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)">E</text>
                <text x="148" y="16"  font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)" text-anchor="middle">Zenith</text>
                <text x="286" y="155" font-family="Space Mono" font-size="9" fill="rgba(120,160,255,0.4)" text-anchor="end">W</text>
                <circle cx={sunX} cy={sunY} r="8" fill="rgba(245,199,106,0.8)" opacity={sunOpacity}/>
                <text x={sunX} y={sunY - 12} font-family="Space Mono" font-size="8" fill="#f5c76a" text-anchor="middle" opacity={sunOpacity}>Sun</text>
                <circle cx={moonX} cy={moonY} r="6" fill="rgba(200,216,248,0.7)" opacity={moonOpacity}/>
                <text x={moonX} y={moonY - 10} font-family="Space Mono" font-size="8" fill="#c8d8f8" text-anchor="middle" opacity={moonOpacity}>Moon</text>
              </svg>
              <p class="arc-note">{arcNote}</p>
              <!-- bron 9 in readme  -->
            </div>
        
            <div class="arc-back">
              <p class="arc-label">What is the zenith?</p>
              <p class="flip-text">The zenith is the point in the sky directly above you, 90° altitude. The arc diagram shows the path the sun and moon travel from east to west, rising above the horizon and passing beneath the zenith, calculated with the azimuth and altitude.</p>
              <!-- bron 7 in readme  -->
            </div>
          </div>
        </div>

        {sky && (
          <>
            <div class="card">
              <svg viewBox="0 0 44 44" width="48" height="48" style="margin-bottom:10px">
                <defs>
                  <clipPath id="moon-clip">
                    <circle cx="22" cy="22" r="20"/>
                  </clipPath>
                </defs>

                <circle cx="22" cy="22" r="20" fill="rgba(200,216,248,0.15)" stroke="rgba(200,216,248,0.3)" stroke-width="0.5"/>
                <circle cx="22" cy="22" r="20" fill="rgba(200,216,248,0.75)" clip-path="url(#moon-clip)"/>
                <circle cx={22 + shadowX} cy="22" r="20" fill="#060812" clip-path="url(#moon-clip)"/>
                <!-- bron 8 in readme  -->
              </svg>

              <p class="card-title">Moon Phase</p>
              <p class="card-main">{sky.moon_phase.replace("_", " ")}</p>
              <p class="card-sub">{Math.round(Math.abs(sky.moon_illumination_percentage))}% illuminated</p>
              <p class="card-sub">Moonrise {sky.moonrise} · Moonset {sky.moonset}</p>
            </div>


            <div class="card sun">
              <p class="card-title">Sun Altitude</p>
              <p class="card-main">{sky.sun_altitude}°</p>
              <p class="card-sub">Sunrise {sky.sunrise} · Sunset {sky.sunset}</p>
              <p class="card-sub">Solar noon {sky.solar_noon}</p>
            </div>

            <div class="stats-row">
              <div class="stat">
                <p class="stat-val">{sky.sunrise}</p>
                <p class="stat-label">Sunrise</p>
              </div>
              <div class="stat">
                <p class="stat-val">{sky.sunset}</p>
                <p class="stat-label">Sunset</p>
              </div>
              <div class="stat">
                <p class="stat-val">{sky.moonrise}</p>
                <p class="stat-label">Moonrise</p>
              </div>
              <div class="stat">
                <p class="stat-val">{sky.moonset}</p>
                <p class="stat-label">Moonset</p>
              </div>
            </div>
          </>
        )}

      </div>
    </main>

    <script>
        if (!window.location.search.includes('lat')) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              window.location.search = `?lat=${pos.coords.latitude}&lng=${pos.coords.longitude}`;
            }
          );
        }

        document.getElementById('my-location-btn').addEventListener('click', () => {
          window.location.href = window.location.pathname;
        });


        document.getElementById('city-btn').addEventListener('click', async () => {
          const city = document.getElementById('city-input').value.trim();
          if (!city) return;

          const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1`);
          const data = await res.json();

          if (!data.results || !data.results.length) {
            alert('City not found');
            return;
          }

          const { latitude, longitude } = data.results[0];
          window.location.search = `?lat=${latitude}&lng=${longitude}`;
        });

          const card = document.querySelector('.arc-details-wrap');
      
          card.addEventListener('click', () => {
          card.classList.toggle('flipped');
        });
    </script>
  </body>
</html>